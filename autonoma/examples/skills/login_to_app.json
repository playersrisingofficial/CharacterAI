{
  "name": "LoginToApp",
  "description": "Logs into a desktop application using provided credentials. The password is supplied by reference, never as a raw value.",
  "skill_type": "form_filling",
  "status": "active",
  "input_schema": {
    "type": "object",
    "properties": {
      "username": { "type": "string" },
      "password_secret_ref": {
        "type": "string",
        "description": "Reference to a stored secret, not the raw password."
      }
    },
    "required": ["username", "password_secret_ref"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "error": { "type": ["string", "null"] }
    },
    "required": ["success"]
  },
  "execution_plan": [
    {
      "step": 1,
      "action": "focus_window",
      "target": "AppLogin",
      "mode": "human_like",
      "expect": { "window_focused": "AppLogin" }
    },
    {
      "step": 2,
      "action": "type",
      "field": "username",
      "value": "{{input.username}}",
      "mode": "human_like",
      "expect": { "field_value": "{{input.username}}" }
    },
    {
      "step": 3,
      "action": "type_secret",
      "field": "password",
      "secret_ref": "{{input.password_secret_ref}}",
      "mode": "machine_speed"
    },
    {
      "step": 4,
      "action": "submit_login",
      "target": "submit_button",
      "mode": "human_like",
      "expect": { "text_visible": "clicked:submit_button" }
    }
  ],
  "constraints": {
    "allowed_windows": ["AppLogin"],
    "forbidden_actions": ["file_delete", "credential_export", "payment_submit"],
    "requires_user_approval_for": ["login_submit"]
  },
  "demonstration_source": {
    "learned_from_demonstration": false,
    "demonstration_count": 0,
    "element_resolution": "fixed_coordinates"
  },
  "behavior_profile": {
    "default_mode": "human_like",
    "allow_per_step_override": true,
    "human_like": {
      "mouse_speed_range": [0.4, 1.2],
      "typing_wpm_range": [45, 90],
      "micro_delay_ms_range": [50, 300]
    },
    "machine_speed": {
      "allow_clipboard_paste": true,
      "artificial_delay_ms": 0
    }
  }
}
