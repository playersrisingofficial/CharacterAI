{
  "name": "FillContactForm",
  "description": "Fills a contact form with a name/email/message and reviews it before submission. Demonstrates multi-field human-like entry with per-field verification.",
  "skill_type": "form_filling",
  "status": "active",
  "input_schema": {
    "type": "object",
    "properties": {
      "full_name": { "type": "string" },
      "email": { "type": "string" },
      "message": { "type": "string" }
    },
    "required": ["full_name", "email"]
  },
  "output_schema": {
    "type": "object",
    "properties": { "success": { "type": "boolean" } },
    "required": ["success"]
  },
  "execution_plan": [
    { "step": 1, "action": "focus_window", "target": "ContactForm", "expect": { "window_focused": "ContactForm" } },
    { "step": 2, "action": "type", "field": "name", "value": "{{input.full_name}}", "expect": { "field_value": "{{input.full_name}}" } },
    { "step": 3, "action": "type", "field": "email", "value": "{{input.email}}", "expect": { "field_value": "{{input.email}}" } },
    { "step": 4, "action": "type", "field": "message", "value": "{{input.message}}" },
    { "step": 5, "action": "click", "target": "review_button", "expect": { "text_visible": "clicked:review_button" } }
  ],
  "constraints": {
    "allowed_windows": ["ContactForm"],
    "forbidden_actions": ["file_delete", "payment_submit", "email_send"]
  },
  "behavior_profile": {
    "default_mode": "human_like",
    "allow_per_step_override": true,
    "human_like": {
      "mouse_speed_range": [0.5, 1.1],
      "typing_wpm_range": [50, 85],
      "micro_delay_ms_range": [40, 220]
    },
    "machine_speed": { "allow_clipboard_paste": true, "artificial_delay_ms": 0 }
  }
}
