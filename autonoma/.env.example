# ---------------------------------------------------------------------------
# Autonoma configuration. Copy to `.env` and adjust. All values have safe
# defaults; nothing here is required to start in the default (safe) mode.
# ---------------------------------------------------------------------------

# Where SQLite + vault data lives.
AUTONOMA_DATA_DIR=./data

# Secret vault master key. If unset, a process-local key is generated and
# secrets do NOT survive a restart. Set a strong random value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTONOMA_VAULT_KEY=

# Desktop automation backend:
#   simulated -> safe, no real OS input (default; works headless / in Docker)
#   desktop   -> real mouse/keyboard via pyautogui (needs a display + extra dep)
AUTONOMA_AUTOMATION_BACKEND=simulated

# Optional: explicit working directory for any skill granted direct file
# access. MUST be a specific project folder — never a root/system/home path
# (e.g. /, C:\, C:\Windows, or a home directory root are refused).
AUTONOMA_WORK_DIR=

# Optional per-session cost ceiling in USD (guards parallel API spend).
AUTONOMA_SESSION_COST_CEILING=

# Stuck-detection thresholds.
AUTONOMA_STUCK_SECONDS=60
AUTONOMA_STUCK_RETRIES=3
AUTONOMA_STUCK_VERIFY_FAILS=3

# Health heartbeat + simulated pacing.
AUTONOMA_HEARTBEAT_INTERVAL=5
AUTONOMA_SIM_STEP_SECONDS=1.2

# CORS + frontend.
AUTONOMA_CORS_ORIGINS=*
AUTONOMA_SERVE_FRONTEND=true

# ---------------------------------------------------------------------------
# Inference provider credentials (API-Based / Hybrid modes).
# The app only ever calls plain chat/completion (incl. multimodal) endpoints —
# never a provider's autonomous agent/tool-use/computer-use endpoint. Set the
# key for whichever provider you configure in the Inference Mode panel.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Local/Hybrid inference only: where model weights are mounted/downloaded.
# AUTONOMA_MODELS_DIR=/models
# AUTONOMA_LOCAL_INFERENCE_ENDPOINT=http://127.0.0.1:11434
